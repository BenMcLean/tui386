{
  "name": "tui386",
  "version": "0.0.0-dev",
  "description": "Make webpages look like the 1980s. A framework-neutral CSS theme with a Tailwind v4 adapter; successor to BOOTSTRA.386.",
  "keywords": [
    "css",
    "tailwind",
    "retro",
    "dos",
    "ega",
    "tui",
    "386",
    "theme"
  ],
  "author": "Benjamin McLean",
  "homepage": "https://github.com/BenMcLean/tui386",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenMcLean/tui386.git"
  },
  "bugs": "https://github.com/BenMcLean/tui386/issues",
  "type": "module",
  "files": [
    "NOTICE",
    "src",
    "dist",
    "fonts"
  ],
  "exports": {
    ".": "./dist/tui386.css",
    "./tailwind": "./dist/tailwind.css",
    "./daisyui": "./dist/daisyui.css",
    "./unocss": "./src/unocss.js",
    "./bootstrap": "./src/bootstrap.scss",
    "./bootstrap-dark": "./src/bootstrap-dark.scss",
    "./bootstrap-components": "./dist/bootstrap.css",
    "./js": "./dist/tui386.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs && node scripts/build-demo.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "node scripts/check-indent.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@unocss/cli": "66.12.0",
    "bootstrap": "5.3.8",
    "daisyui": "5.7.50",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "sass": "1.106.1",
    "tailwindcss": "4.3.3",
    "unocss": "66.12.0"
  },
  "license": "Apache-2.0"
}
